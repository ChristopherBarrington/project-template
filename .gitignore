# ignore any file/path starting with underscore
**/_*

# ignore any secrets (environment variables) files
**/.env
**/.secrets

# ignore a supplementary git repository (eg for publishing code with a separate history)
.git-public/

# ignore the contents of any scratch directory, but track the top-level README
**/scratch/*
!/scratch/README.md

# ignore personal Claude Code settings and instructions
**/.claude/settings.local.json
**/CLAUDE.local.md
