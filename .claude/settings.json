{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(**/private/**/*.*)",
			"Read(!**/private/**/README.md)",
			"Read(!**/private/**/.gitignore)",
			"Read(working/**/inputs/**/*.*)",
			"Read(**/*.bai)",
			"Read(**/*.bam)",
			"Read(**/*.crai)",
			"Read(**/*.cram)",
			"Read(**/*.fastq)",
			"Read(**/*.fastq.*)",
			"Read(**/*.qs2)",
			"Read(**/*.rds)",
			"Read(**/*.sam)",
			"Read(**/*.sam.*)"
		],
		"ask": [
			"Bash(apptainer:*)",
			"Read(**/private/**)",
			"Read(!**/private/**/README.md)",
			"Bash(R:*)",
			"Bash(Rscript:*)",
			"Bash(sbatch:*)",
			"Bash(singularity:*)",
			"Bash(srun:*)",
			"Read(working/**/inputs/**)",
			"Read(working/**/outputs/**)"
		]
	},
	"sandbox": {
		"enabled": true,
		"failIfUnavailable": false,
		"allowUnsandboxedCommands": true,
		"excludedCommands": [
			"apptainer",
			"conda",
			"R",
			"Rscript",
			"singularity",
			"squeue"
		],
		"filesystem": {
			"allowRead": [
				"**/private/**/.gitignore",
				"**/private/**/README.md"
			]
		},
		"network": {
			"allowedDomains": ["*"]
		}
	}
}
