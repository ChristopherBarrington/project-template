{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(**/private/**)",
			"Read(!**/private/**/README.md)",
			"Read(**/working/**/inputs/**/*.*)"
		],
		"ask": [
			"Bash(apptainer:*)",
			"Bash(git checkout:*)",
			"Bash(git merge:*)",
			"Bash(git switch:*)",
			"Bash(sbatch:*)",
			"Bash(singularity:*)",
			"Bash(srun:*)",
			"Read(**/working/**/inputs/**)",
			"Read(**/working/**/outputs/**)"
		]
	},
	"sandbox": {
		"enabled": false
	}
}
