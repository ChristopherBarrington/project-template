{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(**/private/**)",
			"Read(!**/private/**/README.md)",
			"Read(working/**/inputs/**/*.*)"
		],
		"ask": [
			"Bash(apptainer:*)",
			"Bash(sbatch:*)",
			"Bash(singularity:*)",
			"Bash(srun:*)",
			"Read(working/**/inputs/**)",
			"Read(working/**/outputs/**)"
		]
	},
	"sandbox": {
		"enabled": true,
		"failIfUnavailable": false,
		"allowUnsandboxedCommands": true,
		"excludedCommands": [
			"apptainer *",
			"git",
			"singularity *"
		],
		"filesystem": {
			"allowRead": [
				"**/private/**/README.md"
			]
		},
		"network": {
			"allowedDomains": ["*"]
		}
	}
}
 